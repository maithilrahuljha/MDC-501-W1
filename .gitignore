ml-systems-lab/lab4_batch_vs_online/outputs/
ml-systems-lab/lab4_batch_vs_online/data/
ml-systems-lab/lab3_drift/outputs/
ml-systems-lab/lab6_vertex/mlruns/
ml-systems-lab/lab6_vertex/artifacts/

# ---- MLflow's local cache ---------------------------------------------------
mlruns/
mlartifacts/

# ---- tooling ---------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.DS_Store
Thumbs.db

# ---- secrets (the one thing that must NEVER be committed) -------------------
.env
.env.*
*.pem
*credentials*.json
